DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# Add your PC LAN IP so phones on the same Wi‑Fi can open verification links.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
# Comment out DATABASE_URL or set DJANGO_USE_SQLITE=1 to use SQLite locally.
DATABASE_URL=postgres://upanel:upanel@localhost:5432/upanel

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public API URL embedded in verification emails. Must be reachable from the phone
# (LAN IP while developing, https://your-domain.com in production).
PUBLIC_API_URL=http://192.168.1.10:8000

# Deep link on the post-verification browser page (custom scheme or https app link).
APP_RETURN_URL=upanel://open/email-verified
APP_ANDROID_PACKAGE=com.u_panel

# Mailjet (recommended) — API key + secret from https://app.mailjet.com/account/apikeys
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
EMAIL_FROM_NAME=KIU-QA Department
EMAIL_FROM_ADDRESS=kiu-qa-department@orion13.us
DEFAULT_FROM_EMAIL=KIU-QA Department <kiu-qa-department@orion13.us>
# Optional hosted logo URL; leave empty to embed the bundled U-Panel/KIU logo.
# EMAIL_LOGO_URL=https://your-domain.com/static/email/logo.png

# Or generic SMTP instead of Mailjet:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Sentry (optional — leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# OneSignal (optional — leave empty to disable push)
ONESIGNAL_APP_ID=882dcbec-c505-4c12-95c5-78da7e8ef25c
ONESIGNAL_REST_API_KEY=
