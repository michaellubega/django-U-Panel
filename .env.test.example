# Test stack env for Contabo (/opt/test/.env.test)
# Prefer seeding from /opt/upanel/.env.production via deploy-test-on-server.sh.
# Public hostname: https://test.orion13.us (Cloudflare Flexible → origin :80 → TEST_HTTP_PORT)
# Never commit real passwords.
#
# Host port: default 8080 may already be taken on the VPS — use 8085 (or any free port):
#   TEST_HTTP_PORT=8085 bash scripts/contabo/deploy-test-on-server.sh
# Or set TEST_HTTP_PORT below; deploy-test-on-server.sh preserves it when the shell
# env is unset (it no longer overwrites .env.test back to 8080).

DJANGO_SECRET_KEY=generate-a-long-random-string-for-test
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=test.orion13.us,169.58.135.136,localhost,127.0.0.1

POSTGRES_PASSWORD=generate-a-strong-test-password
TEST_HTTP_PORT=8080

PUBLIC_API_URL=https://test.orion13.us
CORS_ALLOWED_ORIGINS=https://test.orion13.us,http://169.58.135.136:8080,http://localhost:8080,http://localhost
CSRF_TRUSTED_ORIGINS=https://test.orion13.us,http://169.58.135.136:8080,http://localhost:8080
APP_RETURN_URL=https://test.orion13.us/app/

DATABASE_URL=postgres://upanel:${POSTGRES_PASSWORD}@db:5432/upanel_test
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MAILJET_API_KEY=
MAILJET_SECRET_KEY=
EMAIL_FROM_NAME=KIU-QA Test
EMAIL_FROM_ADDRESS=kiu-qa-department@orion13.us
DEFAULT_FROM_EMAIL=KIU-QA Test <kiu-qa-department@orion13.us>

APP_ANDROID_PACKAGE=com.u_panel

ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
