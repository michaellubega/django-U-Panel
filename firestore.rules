rules_version = '2';
// U-Panel — Firebase Auth (email/password). Profile: app_users/{uid}. Admin: admins/{uid}.
// Lecturers: lecturers/{uid}. Collection name constants: lib/core/firebase/firestore_collections.dart
service cloud.firestore {
  match /databases/{database}/documents {

    // Accept canonical `isAdmin` or legacy `isadmin` (field names are case-sensitive).
    // Also accept string/number truthy values set manually in the Firebase Console.
    function isTruthy(v) {
      return v == true || v == 'true' || v == 1;
    }

    function isAdminFlag(data) {
      return ('isAdmin' in data && isTruthy(data.isAdmin))
        || ('isadmin' in data && isTruthy(data.isadmin));
    }

    function callerAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function callerLegacyAdminDoc() {
      return get(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    function isCallerAdmin() {
      return request.auth != null && (
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && isAdminFlag(callerAdminDoc().data)
        )
        || (
          exists(/databases/$(database)/documents/admin/$(request.auth.uid))
          && isAdminFlag(callerLegacyAdminDoc().data)
        )
      );
    }

    // Matches AuthRepository._adminDocIsQaStaff (qa_staff role or KIU staff #).
    function isQaStaffData(data) {
      return ('adminRole' in data && data.adminRole == 'qa_staff')
        || (
          (!('adminRole' in data) || data.adminRole != 'administrator')
          && 'staffNumber' in data
          && data.staffNumber is string
          && data.staffNumber.size() > 0
        );
    }

    function isCallerQaStaff() {
      return isCallerAdmin()
        && (
          (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && isQaStaffData(callerAdminDoc().data)
          )
          || (
            exists(/databases/$(database)/documents/admin/$(request.auth.uid))
            && isQaStaffData(callerLegacyAdminDoc().data)
          )
        );
    }

    function isKiuAdminFlag(data) {
      return ('isKiuAdmin' in data && isTruthy(data.isKiuAdmin));
    }

    function adminDocShapeValid() {
      return ('isAdmin' in request.resource.data && request.resource.data.isAdmin is bool)
        || ('isadmin' in request.resource.data && request.resource.data.isadmin is bool);
    }

    // KIU administrator onboarding: own doc may set isKiuAdmin only (not self-grant full admin).
    function callerCanSelfGrantKiuAdmin(adminId) {
      return request.auth != null
        && request.auth.uid == adminId
        && isKiuAdminFlag(request.resource.data)
        && (
          !('isAdmin' in request.resource.data)
          || request.resource.data.isAdmin == false
        )
        && (
          !('isadmin' in request.resource.data)
          || request.resource.data.isadmin == false
        );
    }

    function lecturerDocShapeValid() {
      return 'isLecturer' in request.resource.data
        && request.resource.data.isLecturer is bool
        && (
          (
            'staffNumber' in request.resource.data
            && request.resource.data.staffNumber is string
          )
          || (
            'registrationNumber' in request.resource.data
            && request.resource.data.registrationNumber is string
          )
        );
    }

    // @kiu.ac.ug / ICT staff may bootstrap their own lecturers/{uid} after email verification.
    function callerCanBootstrapOwnLecturer(lecturerId) {
      return request.auth != null
        && request.auth.uid == lecturerId
        && lecturerDocShapeValid()
        && request.resource.data.isLecturer == true;
    }

    function isCallerKiuAdmin() {
      return request.auth != null && (
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && isKiuAdminFlag(get(/databases/$(database)/documents/admins/$(request.auth.uid)).data)
        )
        || (
          exists(/databases/$(database)/documents/admin/$(request.auth.uid))
          && isKiuAdminFlag(get(/databases/$(database)/documents/admin/$(request.auth.uid)).data)
        )
      );
    }

    function isCallerLecturer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/lecturers/$(request.auth.uid))
        && isTruthy(
          get(/databases/$(database)/documents/lecturers/$(request.auth.uid)).data.isLecturer
        );
    }

    function lecturerCanAccessListData(data) {
      return data.lecturerUid == request.auth.uid
        || ('createdBy' in data && data.createdBy == request.auth.uid);
    }

    function lecturerOwnsListId(listId) {
      return exists(/databases/$(database)/documents/attendance_lists/$(listId))
        && lecturerCanAccessListData(
          get(/databases/$(database)/documents/attendance_lists/$(listId)).data
        );
    }

    function lecturerOwnsSessionDoc() {
      return resource.data.keys().hasAll(['listId'])
        && lecturerOwnsListId(resource.data.listId);
    }

    function lecturerOwnsSessionFromRequest() {
      return request.resource.data.keys().hasAll(['listId'])
        && lecturerOwnsListId(request.resource.data.listId);
    }

    function lecturerOwnsSessionById(sessionId) {
      return exists(/databases/$(database)/documents/attendance_sessions/$(sessionId))
        && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.keys().hasAll(['listId'])
        && lecturerOwnsListId(get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.listId);
    }

    function callerRegistration() {
      return request.auth != null
        && exists(/databases/$(database)/documents/app_users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data.get(
            'registrationNumber', ''
          )
        : '';
    }

    function studentOwnsStudentId(studentId) {
      return request.auth != null
        && !isCallerLecturer()
        && !isCallerAdmin()
        && exists(/databases/$(database)/documents/students/$(studentId))
        && get(/databases/$(database)/documents/students/$(studentId)).data.get(
          'registrationNumber', ''
        ) == callerRegistration();
    }

    // Role bootstrap: any signed-in user may read their own admins/{uid} (missing doc = not admin).
    match /admins/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow get, list: if isCallerAdmin();
      allow create, update: if (
        isCallerAdmin() && adminDocShapeValid()
      ) || callerCanSelfGrantKiuAdmin(adminId);
      allow delete: if isCallerAdmin();
    }

    // Legacy admin collection (same shape as [admins]); kept for existing documents.
    match /admin/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow get, list: if isCallerAdmin();
      allow create, update: if (
        isCallerAdmin() && adminDocShapeValid()
      ) || callerCanSelfGrantKiuAdmin(adminId);
      allow delete: if isCallerAdmin();
    }

    match /lecturers/{lecturerId} {
      // Role bootstrap: any signed-in user may read their own lecturers/{uid} (missing doc = not lecturer).
      allow get: if request.auth != null && request.auth.uid == lecturerId;
      allow get, list: if isCallerAdmin();
      allow create, update: if (
        isCallerAdmin() && lecturerDocShapeValid()
      ) || callerCanBootstrapOwnLecturer(lecturerId);
      allow delete: if isCallerAdmin();
    }

    // Lecturer/QA registration: manual ids use create (pending) then update (assign uid).
    // `allow update` must be true for admins — a final .set() on an existing doc is an update.
    match /staff_numbers/{staffId} {
      allow get: if request.auth != null && isCallerAdmin();
      allow list: if request.auth != null && isCallerAdmin();
      allow create, update, delete: if isCallerAdmin();
    }

    // Student signup: one registration number ↔ one Auth uid + school email (immutable).
    match /student_registrations/{regId} {
      // Any signed-in user may read a lock doc to detect "already taken" during signup.
      allow read: if request.auth != null;
      allow list: if isCallerAdmin();
      // Create when the lock doc does not exist yet (signup transaction).
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.uid is string
        && request.resource.data.email is string
        && request.resource.data.registrationNumber is string
        && request.resource.data.registrationNumber == regId
        && (!('fullName' in request.resource.data)
          || request.resource.data.fullName is string);
      // Owner may retry signup; cannot change email or take another student's lock.
      allow update: if isCallerAdmin()
        || (
          request.auth != null
          && resource.data.uid == request.auth.uid
          && request.auth.uid == request.resource.data.uid
          && request.resource.data.registrationNumber == regId
          && request.resource.data.email == resource.data.email
          && (!('fullName' in request.resource.data)
            || request.resource.data.fullName is string)
        );
      allow delete: if isCallerAdmin();
    }

    // Atomic KIU-#### counter; create on first use is allowed for admins.
    match /meta/{docId} {
      // Lightweight server ping for offline detection (doc may not exist).
      // `read` (not only `get`) so signed-out snapshot listeners are allowed.
      allow read: if docId == 'connectivity';
      // QA / full admins configure; KIU administrators read for check-in validation.
      allow read: if docId == 'campus_geofence'
        && (isCallerAdmin() || isCallerKiuAdmin());
      allow get: if isCallerAdmin() && docId == 'lecturer_staff_counter';
      allow write: if isCallerAdmin() && docId == 'lecturer_staff_counter';
      allow create, update: if isCallerQaStaff()
        && docId == 'campus_geofence'
        && request.resource.data.keys().hasAll([
          'latitude', 'longitude', 'radiusMeters'
        ])
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.radiusMeters is number
        && request.resource.data.radiusMeters >= 1500
        && request.resource.data.radiusMeters <= 5000
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // QA staff / administrator campus arrival and departure (immutable log).
    match /admin_campus_presence/{docId} {
      allow get: if isCallerAdmin();
      // KIU admins may read their own row, including a missing doc id before first check-in.
      allow get: if isCallerKiuAdmin()
        && (
          !exists(/databases/$(database)/documents/admin_campus_presence/$(docId))
          || resource.data.adminUid == request.auth.uid
        );
      allow list: if isCallerAdmin();
      allow list: if isCallerKiuAdmin()
        && resource.data.adminUid == request.auth.uid;
      allow create: if isCallerKiuAdmin()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.kind is string
        && request.resource.data.localDateKey is string
        && request.resource.data.capturedAt is timestamp
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && !exists(/databases/$(database)/documents/admin_campus_presence/$(docId));
      allow update, delete: if false;
    }

    match /app_users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && (
        request.auth.uid == userId || isCallerAdmin()
      );
      allow update: if request.auth != null && (
        request.auth.uid == userId || isCallerAdmin()
      );
      allow delete: if false;
    }

    match /attendance_lists/{docId} {
      // Lecturer loads use where(lecturerUid) and where(createdBy) — each query must
      // match a single read rule (Firestore cannot OR-combine query constraints).
      allow read: if isCallerAdmin();
      allow read: if request.auth != null && !isCallerLecturer();
      allow read: if isCallerLecturer()
        && resource.data.lecturerUid == request.auth.uid;
      allow read: if isCallerLecturer()
        && resource.data.createdBy == request.auth.uid;
      allow create: if request.auth != null && (
        isCallerAdmin()
        || (isCallerLecturer() && request.resource.data.lecturerUid == request.auth.uid)
      );
      allow update: if request.auth != null && (
        isCallerAdmin()
        || (
          isCallerLecturer()
          && lecturerCanAccessListData(resource.data)
          && request.resource.data.lecturerUid == resource.data.lecturerUid
        )
      );
      allow delete: if request.auth != null && (
        isCallerAdmin()
        || (
          isCallerLecturer()
          && lecturerCanAccessListData(resource.data)
        )
      );
    }

    match /attendance_sessions/{docId} {
      allow read: if isCallerAdmin();
      allow read: if request.auth != null && !isCallerLecturer();
      allow read: if isCallerLecturer() && lecturerOwnsSessionDoc();
      // Join-code queries: where sessionCode == … (students + lecturers signing in).
      allow read: if request.auth != null
        && resource.data.keys().hasAll(['sessionCode']);
      allow create, update: if request.auth != null && (
        isCallerAdmin()
        || !isCallerLecturer()
        || lecturerOwnsSessionFromRequest()
      );
      allow delete: if request.auth != null && (
        isCallerAdmin()
        || !isCallerLecturer()
        || (resource.data.keys().hasAll(['listId']) && lecturerOwnsListId(resource.data.listId))
      );
    }

    match /attendance_records/{docId} {
      allow read: if isCallerAdmin();
      allow read: if request.auth != null && !isCallerLecturer();
      allow read: if isCallerLecturer()
        && resource.data.keys().hasAll(['sessionId'])
        && lecturerOwnsSessionById(resource.data.sessionId);
      // Official roll rows: Cloud Functions (Admin SDK) only.
      allow create, update, delete: if false;
    }

    // Device-uploaded check-in evidence; reconciled server-side into attendance_records.
    match /check_in_attempts/{docId} {
      allow read: if isCallerAdmin();
      allow read: if request.auth != null && !isCallerLecturer()
        && resource.data.keys().hasAll(['studentId'])
        && studentOwnsStudentId(resource.data.studentId);
      allow read: if isCallerLecturer()
        && resource.data.keys().hasAll(['sessionId'])
        && lecturerOwnsSessionById(resource.data.sessionId);

      function hasDeviceId() {
        return request.resource.data.keys().hasAll(['deviceId'])
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() > 0;
      }

      function isAwaitingSessionClaim() {
        return request.resource.data.get('awaitingSession', false) == true
          && request.resource.data.keys().hasAll([
            'sessionCodeRaw', 'studentId', 'capturedAt', 'latitude', 'longitude'
          ]);
      }

      function isFullCheckInAttempt() {
        return request.resource.data.keys().hasAll([
          'sessionId', 'studentId', 'listId', 'course',
          'capturedAt', 'latitude', 'longitude'
        ]);
      }

      allow create: if studentOwnsStudentId(request.resource.data.studentId)
        && request.resource.data.status == 'pending'
        && hasDeviceId()
        && (isFullCheckInAttempt() || isAwaitingSessionClaim());
      allow update: if studentOwnsStudentId(request.resource.data.studentId)
        && request.resource.data.status == 'pending'
        && hasDeviceId()
        && (resource.data.status == 'pending' || resource.data.status == 'rejected');
      allow delete: if false;
    }

    // Server-only: one present check-in per session per device (Cloud Functions).
    match /device_session_locks/{lockId} {
      allow read, write: if false;
    }

    match /students/{docId} {
      function callerRegistration() {
        return exists(/databases/$(database)/documents/app_users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data.get(
              'registrationNumber', ''
            )
          : '';
      }

      allow get: if request.auth != null && (
        isCallerAdmin()
        || isCallerLecturer()
        || (
          resource.data.keys().hasAll(['registrationNumber'])
          && resource.data.registrationNumber == callerRegistration()
        )
      );
      allow list: if request.auth != null && (
        isCallerAdmin()
        || (
          resource.data.keys().hasAll(['registrationNumber'])
          && resource.data.registrationNumber == callerRegistration()
        )
      );
      allow create, update: if request.auth != null;
      allow delete: if isCallerAdmin();
    }

    match /sign_ins/{docId} {
      allow read: if isCallerAdmin();
      allow read: if request.auth != null && !isCallerLecturer();
      allow read: if isCallerLecturer()
        && resource.data.keys().hasAll(['listId'])
        && lecturerOwnsListId(resource.data.listId);
      allow create, update: if request.auth != null && (
        isCallerAdmin()
        || !isCallerLecturer()
        || (
          request.resource.data.keys().hasAll(['listId'])
          && lecturerOwnsListId(request.resource.data.listId)
        )
      );
      allow delete: if request.auth != null && (
        isCallerAdmin()
        || !isCallerLecturer()
        || (resource.data.keys().hasAll(['listId']) && lecturerOwnsListId(resource.data.listId))
      );
    }

    function lecturerCanPublishManualClassNotice() {
      return isCallerLecturer()
        && request.resource.data.audience == 'classList'
        && request.resource.data.keys().hasAll(['targetListId'])
        && lecturerOwnsListId(request.resource.data.targetListId)
        && (
          !('kind' in request.resource.data)
          || request.resource.data.kind == 'manual'
        );
    }

    // Session join-code notice: lecturer owns the list or started the session (createdByUid).
    function lecturerCanPublishSessionStartNotice() {
      return isCallerLecturer()
        && request.resource.data.audience == 'classList'
        && request.resource.data.kind == 'sessionCode'
        && request.resource.data.keys().hasAll(['targetListId', 'sessionId'])
        && exists(
          /databases/$(database)/documents/attendance_sessions/$(request.resource.data.sessionId)
        )
        && get(
          /databases/$(database)/documents/attendance_sessions/$(request.resource.data.sessionId)
        ).data.listId == request.resource.data.targetListId
        && (
          lecturerOwnsListId(request.resource.data.targetListId)
          || (
            get(
              /databases/$(database)/documents/attendance_sessions/$(request.resource.data.sessionId)
            ).data.keys().hasAll(['createdByUid'])
            && get(
              /databases/$(database)/documents/attendance_sessions/$(request.resource.data.sessionId)
            ).data.createdByUid == request.auth.uid
          )
        );
    }

    match /notices/{noticeId} {
      allow read: if request.auth != null;
      allow create, update: if isCallerAdmin()
        || lecturerCanPublishManualClassNotice()
        || lecturerCanPublishSessionStartNotice();
      allow delete: if request.auth != null;
    }
  }
}
