rules_version = '2';
// U-Panel — Firebase Auth (email/password). Profile: app_users/{uid}. Admin: admins/{uid}.
// Lecturers: lecturers/{uid}. Collection name constants: lib/core/firebase/firestore_collections.dart
service cloud.firestore {
  match /databases/{database}/documents {

    // Accept canonical `isAdmin` or legacy `isadmin` (field names are case-sensitive).
    // Also accept string/number truthy values set manually in the Firebase Console.
    function isTruthy(v) {
      return v == true || v == 'true' || v == 1;
    }

    function isAdminFlag(data) {
      return ('isAdmin' in data && isTruthy(data.isAdmin))
        || ('isadmin' in data && isTruthy(data.isadmin));
    }

    function callerAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function callerLegacyAdminDoc() {
      return get(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    function isCallerAdmin() {
      return request.auth != null && (
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && isAdminFlag(callerAdminDoc().data)
        )
        || (
          exists(/databases/$(database)/documents/admin/$(request.auth.uid))
          && isAdminFlag(callerLegacyAdminDoc().data)
        )
      );
    }

    function isCallerLecturer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/lecturers/$(request.auth.uid))
        && isTruthy(
          get(/databases/$(database)/documents/lecturers/$(request.auth.uid)).data.isLecturer
        );
    }

    function lecturerCanAccessListData(data) {
      return data.lecturerUid == request.auth.uid
        || ('createdBy' in data && data.createdBy == request.auth.uid);
    }

    function lecturerOwnsListId(listId) {
      return exists(/databases/$(database)/documents/attendance_lists/$(listId))
        && lecturerCanAccessListData(
          get(/databases/$(database)/documents/attendance_lists/$(listId)).data
        );
    }

    function lecturerOwnsSessionDoc() {
      return resource.data.keys().hasAll(['listId'])
        && lecturerOwnsListId(resource.data.listId);
    }

    function lecturerOwnsSessionFromRequest() {
      return request.resource.data.keys().hasAll(['listId'])
        && lecturerOwnsListId(request.resource.data.listId);
    }

    function lecturerOwnsSessionById(sessionId) {
      return exists(/databases/$(database)/documents/attendance_sessions/$(sessionId))
        && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.keys().hasAll(['listId'])
        && lecturerOwnsListId(get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.listId);
    }

    // Role bootstrap: any signed-in user may read their own admins/{uid} (missing doc = not admin).
    match /admins/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow get, list: if isCallerAdmin();
      allow create, update: if isCallerAdmin()
        && (
          ('isAdmin' in request.resource.data && request.resource.data.isAdmin is bool)
          || ('isadmin' in request.resource.data && request.resource.data.isadmin is bool)
        );
      allow delete: if isCallerAdmin();
    }

    // Legacy admin collection (same shape as [admins]); kept for existing documents.
    match /admin/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow get, list: if isCallerAdmin();
      allow create, update: if isCallerAdmin()
        && (
          ('isAdmin' in request.resource.data && request.resource.data.isAdmin is bool)
          || ('isadmin' in request.resource.data && request.resource.data.isadmin is bool)
        );
      allow delete: if isCallerAdmin();
    }

    match /lecturers/{lecturerId} {
      // Role bootstrap: any signed-in user may read their own lecturers/{uid} (missing doc = not lecturer).
      allow get: if request.auth != null && request.auth.uid == lecturerId;
      allow get, list: if isCallerAdmin();
      allow create, update: if isCallerAdmin()
        && 'isLecturer' in request.resource.data
        && 'staffNumber' in request.resource.data
        && request.resource.data.isLecturer is bool
        && request.resource.data.staffNumber is string;
      allow delete: if isCallerAdmin();
    }

    // Lecturer/QA registration: manual ids use create (pending) then update (assign uid).
    // `allow update` must be true for admins — a final .set() on an existing doc is an update.
    match /staff_numbers/{staffId} {
      allow get: if request.auth != null && isCallerAdmin();
      allow list: if request.auth != null && isCallerAdmin();
      allow create, update, delete: if isCallerAdmin();
    }

    // Student signup: one registration number ↔ one Auth uid + school email (immutable).
    match /student_registrations/{regId} {
      // Any signed-in user may read a lock doc to detect "already taken" during signup.
      allow read: if request.auth != null;
      allow list: if isCallerAdmin();
      // Create when the lock doc does not exist yet (signup transaction).
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.uid is string
        && request.resource.data.email is string
        && request.resource.data.registrationNumber is string
        && request.resource.data.registrationNumber == regId;
      // Owner may retry signup; cannot change email or take another student's lock.
      allow update: if isCallerAdmin()
        || (
          request.auth != null
          && resource.data.uid == request.auth.uid
          && request.auth.uid == request.resource.data.uid
          && request.resource.data.registrationNumber == regId
          && request.resource.data.email == resource.data.email
        );
      allow delete: if isCallerAdmin();
    }

    // Atomic KIU-#### counter; create on first use is allowed for admins.
    match /meta/{docId} {
      allow get: if isCallerAdmin() && docId == 'lecturer_staff_counter';
      allow write: if isCallerAdmin() && docId == 'lecturer_staff_counter';
    }

    match /app_users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && (
        request.auth.uid == userId || isCallerAdmin()
      );
      allow update: if request.auth != null && (
        request.auth.uid == userId || isCallerAdmin()
      );
      allow delete: if false;
    }

    match /attendance_lists/{docId} {
      // Lecturer loads use where(lecturerUid) and where(createdBy) — each query must
      // match a single read rule (Firestore cannot OR-combine query constraints).
      allow read: if isCallerAdmin();
      allow read: if request.auth != null && !isCallerLecturer();
      allow read: if isCallerLecturer()
        && resource.data.lecturerUid == request.auth.uid;
      allow read: if isCallerLecturer()
        && resource.data.createdBy == request.auth.uid;
      allow create: if request.auth != null && (
        isCallerAdmin()
        || (isCallerLecturer() && request.resource.data.lecturerUid == request.auth.uid)
      );
      allow update: if request.auth != null && (
        isCallerAdmin()
        || (
          isCallerLecturer()
          && lecturerCanAccessListData(resource.data)
          && request.resource.data.lecturerUid == resource.data.lecturerUid
        )
      );
      allow delete: if request.auth != null && (
        isCallerAdmin()
        || (
          isCallerLecturer()
          && lecturerCanAccessListData(resource.data)
        )
      );
    }

    match /attendance_sessions/{docId} {
      allow read: if isCallerAdmin();
      allow read: if request.auth != null && !isCallerLecturer();
      allow read: if isCallerLecturer() && lecturerOwnsSessionDoc();
      // Join-code queries: where sessionCode == … (students + lecturers signing in).
      allow read: if request.auth != null
        && resource.data.keys().hasAll(['sessionCode']);
      allow create, update: if request.auth != null && (
        isCallerAdmin()
        || !isCallerLecturer()
        || lecturerOwnsSessionFromRequest()
      );
      allow delete: if request.auth != null && (
        isCallerAdmin()
        || !isCallerLecturer()
        || (resource.data.keys().hasAll(['listId']) && lecturerOwnsListId(resource.data.listId))
      );
    }

    match /attendance_records/{docId} {
      allow read: if isCallerAdmin();
      allow read: if request.auth != null && !isCallerLecturer();
      allow read: if isCallerLecturer()
        && resource.data.keys().hasAll(['sessionId'])
        && lecturerOwnsSessionById(resource.data.sessionId);
      allow create, update: if request.auth != null && (
        isCallerAdmin()
        || !isCallerLecturer()
        || (
          request.resource.data.keys().hasAll(['sessionId'])
          && lecturerOwnsSessionById(request.resource.data.sessionId)
        )
      );
      allow delete: if request.auth != null && (
        isCallerAdmin()
        || !isCallerLecturer()
        || (
          resource.data.keys().hasAll(['sessionId'])
          && lecturerOwnsSessionById(resource.data.sessionId)
        )
      );
    }

    match /students/{docId} {
      allow read, write: if request.auth != null;
    }

    match /sign_ins/{docId} {
      allow read: if isCallerAdmin();
      allow read: if request.auth != null && !isCallerLecturer();
      allow read: if isCallerLecturer()
        && resource.data.keys().hasAll(['listId'])
        && lecturerOwnsListId(resource.data.listId);
      allow create, update: if request.auth != null && (
        isCallerAdmin()
        || !isCallerLecturer()
        || (
          request.resource.data.keys().hasAll(['listId'])
          && lecturerOwnsListId(request.resource.data.listId)
        )
      );
      allow delete: if request.auth != null && (
        isCallerAdmin()
        || !isCallerLecturer()
        || (resource.data.keys().hasAll(['listId']) && lecturerOwnsListId(resource.data.listId))
      );
    }

    function lecturerCanPublishManualClassNotice() {
      return isCallerLecturer()
        && request.resource.data.audience == 'classList'
        && request.resource.data.keys().hasAll(['targetListId'])
        && lecturerOwnsListId(request.resource.data.targetListId)
        && (
          !('kind' in request.resource.data)
          || request.resource.data.kind == 'manual'
        );
    }

    // Session join-code notice: lecturer owns the list or started the session (createdByUid).
    function lecturerCanPublishSessionStartNotice() {
      return isCallerLecturer()
        && request.resource.data.audience == 'classList'
        && request.resource.data.kind == 'sessionCode'
        && request.resource.data.keys().hasAll(['targetListId', 'sessionId'])
        && exists(
          /databases/$(database)/documents/attendance_sessions/$(request.resource.data.sessionId)
        )
        && get(
          /databases/$(database)/documents/attendance_sessions/$(request.resource.data.sessionId)
        ).data.listId == request.resource.data.targetListId
        && (
          lecturerOwnsListId(request.resource.data.targetListId)
          || (
            get(
              /databases/$(database)/documents/attendance_sessions/$(request.resource.data.sessionId)
            ).data.keys().hasAll(['createdByUid'])
            && get(
              /databases/$(database)/documents/attendance_sessions/$(request.resource.data.sessionId)
            ).data.createdByUid == request.auth.uid
          )
        );
    }

    match /notices/{noticeId} {
      allow read: if request.auth != null;
      allow create, update: if isCallerAdmin()
        || lecturerCanPublishManualClassNotice()
        || lecturerCanPublishSessionStartNotice();
      allow delete: if request.auth != null;
    }
  }
}
