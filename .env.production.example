# Production environment for Contabo VPS (/opt/upanel/.env.production)
# Copy to the server and fill in secrets. Never commit real passwords to git.

DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.orion13.us,169.58.135.136,localhost,127.0.0.1

POSTGRES_PASSWORD=generate-a-strong-password

# HTTPS via Cloudflare (Flexible SSL → origin port 80). See scripts/contabo/setup-cloudflare-https.sh
# Until api.orion13.us DNS is live, use the VPS IP so verification links in emails work:
PUBLIC_API_URL=http://169.58.135.136
CORS_ALLOWED_ORIGINS=https://kiu.orion13.us,https://api.orion13.us
CSRF_TRUSTED_ORIGINS=https://kiu.orion13.us,https://api.orion13.us
APP_RETURN_URL=https://kiu.orion13.us/app/

DATABASE_URL=postgres://upanel:${POSTGRES_PASSWORD}@db:5432/upanel
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MAILJET_API_KEY=
MAILJET_SECRET_KEY=
EMAIL_FROM_NAME=KIU-QA Department
EMAIL_FROM_ADDRESS=kiu-qa-department@orion13.us
DEFAULT_FROM_EMAIL=KIU-QA Department <kiu-qa-department@orion13.us>

APP_ANDROID_PACKAGE=com.u_panel
