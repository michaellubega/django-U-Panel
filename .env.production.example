# Production environment for Contabo VPS (/opt/upanel/.env.production)
# Copy to the server and fill in secrets. Never commit real passwords to git.
# Fix typos automatically: bash scripts/contabo/fix-production-env.sh

DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=169.58.135.136,api.orion13.us,kiu.orion13.us,localhost,127.0.0.1

POSTGRES_PASSWORD=generate-a-strong-password

# HTTPS via Cloudflare (Flexible SSL → origin port 80). See docs/CLOUDFLARE_DNS_SETUP.md
PUBLIC_API_URL=https://kiu.orion13.us
CORS_ALLOWED_ORIGINS=https://kiu.orion13.us,https://api.orion13.us,http://169.58.135.136,http://localhost
CSRF_TRUSTED_ORIGINS=https://kiu.orion13.us,https://api.orion13.us
APP_RETURN_URL=https://kiu.orion13.us/app/

DATABASE_URL=postgres://upanel:${POSTGRES_PASSWORD}@db:5432/upanel
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MAILJET_API_KEY=
MAILJET_SECRET_KEY=
EMAIL_FROM_NAME=KIU-QA Department
EMAIL_FROM_ADDRESS=kiu-qa-department@orion13.us
DEFAULT_FROM_EMAIL=KIU-QA Department <kiu-qa-department@orion13.us>

APP_ANDROID_PACKAGE=com.u_panel

ONESIGNAL_APP_ID=882dcbec-c505-4c12-95c5-78da7e8ef25c
# App API Key from OneSignal Dashboard → Settings → Keys & IDs (starts with os_v2_app_)
ONESIGNAL_REST_API_KEY=

# Optional — purge Cloudflare edge cache after web deploy (see scripts/contabo/purge-cloudflare-cache.sh)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
